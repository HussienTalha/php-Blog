{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy.Dockerfile",
    "buildCommand": "docker build -t myapp -f deploy.Dockerfile ."
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "port": 80
  }
}
